{
  // Autonomous enhancement pipeline. Every value here is optional — delete a key
  // to fall back to the built-in default. Layered: built-in defaults, then
  // ~/.claude-pipeline/config.json (shared across all your repos), then this file.
  //
  // The repo's own CLAUDE.md, .claude/settings.json, skills, hooks, subagents and
  // slash commands apply automatically: agents run with this repo as their working
  // directory, so the Claude CLI picks them up. Put project-specific rules there,
  // not in the prompts below.

  "name": "",                        // defaults to the repo folder name
  "pipelineDirName": ".claude-pipeline",
  "branchTemplate": "claude/cycle-{cycle}",

  "cycleDelayMinutes": 15,
  "waitOnLimitMinutes": null,        // null = save state and exit on a usage limit
  "maxCycles": 0,                    // 0 = run until stopped
  "maxAgentRetries": 2,
  "retryDelaySeconds": 30,
  "agentTimeoutMinutes": 60,

  // Spending limits. 0 = no limit, which is the default: nothing here changes
  // behaviour until you set a number.
  "budget": {
    "maxCostPerCycleUsd": 3.00,      // one cycle's spend — cycle 2 cost $2.62
    "maxCostTotalUsd": 20.00,        // running total, kept in state.json across restarts
    "warnAtPercent": 80,             // log a warning once at this share of a limit
    "onExceeded": "stop"             // "stop" halts at once; "finish-cycle" completes the cycle
  },

  // Optional list of work for the Architect to choose from. Leave the file empty and
  // it picks its own work, exactly as it would without a backlog. Write items as
  // "- [ ] do the thing" and it will prefer them, most important first.
  "backlog": {
    "enabled": true,
    "file": ".claude-pipeline/BACKLOG.md",
    "createIfMissing": true
  },

  // Writes the log to .claude-pipeline/logs/ and cycle history to history.jsonl, so
  // both survive a restart and a stop overnight can still be investigated.
  "journal": {
    "enabled": true,
    "retentionDays": 14
  },

  // POSTs JSON to a webhook so an unattended run can reach you. The payload carries
  // "text" and "content" as well as structured fields, so Slack and Discord incoming
  // webhooks work as they are. Remove events you do not want; add "cycle-completed"
  // if you want to hear about every successful cycle too.
  "notifications": {
    "enabled": false,
    "webhookUrl": "",
    "timeoutSeconds": 10,
    "events": ["stopped", "budget-reached", "usage-limit", "agent-failed", "cycle-reverted", "published"]
  },

  // What to do if a cycle starts with uncommitted changes in the repo:
  // "stash" (default), "commit" onto the current branch, "fail", or "ignore".
  "onDirtyWorkingTree": "stash",

  "dashboardEnabled": true,
  "dashboardPort": 5199,
  "dashboardListenOnAllInterfaces": false,   // the page has no auth — keep local

  // Usable as {name} in any prompt or command below. sourceDir and testCommand
  // are auto-detected from the project when left empty.
  "variables": {
    "sourceDir": "",
    "testCommand": "",
    // Cycles accumulate on this long-lived branch instead of going straight to
    // your default branch. Each cycle branches from it and merges back into it,
    // so later cycles can build on earlier ones. The publish stage below opens a
    // single pull request from here to {defaultBranch} every few cycles — that is
    // the human review gate.
    "integrationBranch": "claude/integration",
    "specFile": ".claude-pipeline/queue/1_proposed/task-latest.md",
    "workingSpecFile": ".claude-pipeline/queue/2_testing/task-latest.md",
    "reportFile": ".claude-pipeline/queue/3_reports/report-latest.md",
    "verifyReportFile": ".claude-pipeline/queue/3_reports/verify-latest.md",
    "progressFile": ".claude-pipeline/PROGRESS.md",
    "backlogFile": ".claude-pipeline/BACKLOG.md"
  },

  "claude": {
    "executable": "claude",
    "baseArgs": ["--dangerously-skip-permissions"],
    "promptFlag": "-p",
    "model": null,                   // e.g. "opus" to set a default for every stage
    "extraArgs": [],
    // "stream-json" streams progress live AND returns cost, tokens and a session id.
    // Set to "text" only if your CLI does not support it — you lose cost tracking,
    // session reuse, and reliable usage-limit detection.
    "outputFormat": "stream-json",
    // Re-enter a stage's own session when it re-runs to fix a failed gate, instead
    // of starting cold and re-reading everything it just wrote.
    "resumeFixRounds": true
  },

  // Stages run in order. Add, remove, reorder or disable them freely.
  // A stage may set "extraArgs" (e.g. ["--model","haiku"]), "preCommand"/"postCommand"
  // shell steps, a "gate" that sends work back to an earlier stage, "runEveryCycles"
  // to fire only periodically, and "continueOnFailure" so a failure is not fatal.
  "stages": [
    {
      "id": "architect",
      "name": "Architect",
      // Guarantees every cycle starts from the integration branch, whatever state
      // the previous cycle left the repo in. Creates the branch on first run.
      "preCommand": "git checkout {integrationBranch} || git checkout -b {integrationBranch}",
      // {backlogInstruction} expands to the backlog rule, or to nothing when
      // backlog.enabled is false.
      "prompt": "You are the Architect. {backlogInstruction}Read {progressFile} for what has already been done — including work that is merged into '{integrationBranch}' but not yet in '{defaultBranch}'. Study the project (see CLAUDE.md if present) and identify ONE small, self-contained enhancement or refactor in {sourceDir}. It may build on earlier cycles' work, which is already present on this branch. Write a concise spec — goal, files to touch, acceptance criteria — to {specFile}. Do NOT modify source code.",
      "produces": "{specFile}"
    },
    {
      "id": "developer",
      "name": "Developer",
      "prompt": "You are the Developer. Read the spec at {specFile}. Create git branch '{branch}' from '{integrationBranch}', implement the change, and commit it. Then move the spec to {workingSpecFile}. Follow the conventions in CLAUDE.md if present.",
      "fixPrompt": "You are the Developer. QA failed on branch '{branch}'. Read the failure report at {reportFile} and the spec at {workingSpecFile}. Stay on '{branch}', fix the reported problems, and commit the fixes.",
      "requiresAnyOf": ["{specFile}", "{workingSpecFile}"]
    },
    {
      "id": "qa",
      "name": "QA",
      "prompt": "You are QA. Make sure you are on git branch '{branch}'. Run the test suite: {testCommand}. Review the diff against the spec at {workingSpecFile}. Write a report to {reportFile} whose FIRST line is exactly 'STATUS: PASS' or 'STATUS: FAIL', followed by the details.",
      "produces": "{reportFile}",
      "gate": {
        "file": "{reportFile}",
        "passPattern": "STATUS:\\s*PASS",
        "failPattern": "STATUS:\\s*FAIL",
        "missingMeansFail": true,
        "onFailGoTo": "developer",
        "maxAttempts": 2
      }
    },
    {
      "id": "organizer",
      "name": "Organizer",
      // Mechanical work: run git commands, append a line to a file. A small model is
      // enough. Remove this to run it on the pipeline-wide model.
      "extraArgs": ["--model", "haiku"],
      "prompt": "You are the Organizer. Read {reportFile}. If STATUS is PASS: check out '{integrationBranch}' and merge '{branch}' into it with a merge commit (--no-ff). If STATUS is FAIL: check out '{integrationBranch}' and abandon the branch's changes — do not merge. In BOTH cases: append a one-line entry to {progressFile} recording the cycle number, what was attempted and the outcome; if {progressFile} has more than 200 lines, first condense everything except the 50 most recent entries into a short 'Earlier work' summary section so the file stops growing without bound. {backlogCompletion}Commit {progressFile} to '{integrationBranch}', delete branch '{branch}', and clear the files under {pipelineDir}/queue/. Finish with '{integrationBranch}' checked out and the working tree clean. Never push, and never merge into '{defaultBranch}' — a later stage opens a pull request for that."
    },
    {
      // Cycles are tested in isolation, so two changes that each pass can still break
      // together once merged. This re-runs the suite on the combined branch and undoes
      // the merge if it broke — without it, the breakage silently reaches the pull request.
      "id": "verify",
      "name": "Verify",
      "prompt": "You are the Integration Verifier. You are on '{integrationBranch}', which now includes the merge from cycle {cycle}. Run the full test suite on the branch as a whole: {testCommand}. Write a report to {verifyReportFile} whose FIRST line is exactly 'STATUS: PASS' or 'STATUS: FAIL'. If it FAILS: revert this cycle's merge commit on '{integrationBranch}' (git revert -m 1 <merge commit>), commit the revert, record in {progressFile} that cycle {cycle} was reverted after failing integration verification, and confirm the suite passes again afterwards. Leave the working tree clean.",
      "produces": "{verifyReportFile}",
      "gate": {
        "file": "{verifyReportFile}",
        "passPattern": "STATUS:\\s*PASS",
        "failPattern": "STATUS:\\s*FAIL",
        "missingMeansFail": true,
        "onFailGoTo": "",
        "maxAttempts": 0
      }
    },
    {
      "id": "publish",
      "name": "Publish",
      // The review gate: batches accumulated cycles into one pull request.
      // Raise this to review less often, or set enabled=false to keep everything local.
      "runEveryCycles": 5,
      "continueOnFailure": true,
      "maxRetries": 0,                 // a missing remote will not fix itself on retry
      "notifyOnSuccess": "published",  // the moment there is something for you to review
      // Pushes a branch and writes a PR description from entries already in
      // {progressFile} — summarising, not authoring. A small model is enough.
      "extraArgs": ["--model", "haiku"],
      "prompt": "You are the Publisher. The branch '{integrationBranch}' holds several completed cycles that are not yet in '{defaultBranch}'. Push '{integrationBranch}' to the remote. Then, using the gh CLI, open a pull request from '{integrationBranch}' into '{defaultBranch}' — or update the existing one if a pull request is already open. Write the description from the entries in {progressFile} that are not yet in '{defaultBranch}': one bullet per cycle, saying what changed and why. Do not merge the pull request; a human reviews it. If there is no git remote or gh is unavailable, report that clearly and stop without making changes."
    }
  ]
}