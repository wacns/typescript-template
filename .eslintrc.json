{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "overrides": [
        {
            "files": [
                "src/**/worker*.ts",
                "src/**/*-worker.ts",
                "src/**/hackloop.ts",
                "src/lib/hack-loop.ts",
                "src/WacnOS/helpers/shareRam.ts",
                "src/WacnOS/launcher/procure.ts",
                "src/Workers/**/*.ts",
                "src/Dispatchers/**/*.ts",
                "src/Utils/auto-darkweb.ts"
            ],
            "rules": {
                "no-constant-condition": [
                    "error",
                    {
                        "checkLoops": false
                    }
                ]
            }
        }
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "ignorePatterns": [
        "node_modules/**",
        "build/**",
        "dist/**",
        "NetscriptDefinitions.d.ts",
        "src/SphyxOS/**",
        "src/Loader.js",
        "src/installer.ts",
        "src/Dispatchers/archive/**"
    ],
    "rules": {
    }
}
